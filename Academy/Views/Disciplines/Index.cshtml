@model IEnumerable<Academy.Models.Discipline>

@{
    ViewData["Title"] = "Дисциплины";
}

<div class="controls">
    <h1>Дисциплины</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary">Добавить</a>
    </p>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]">
                    @Html.DisplayNameFor(model => model.discipline_name)
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["LessonsSortParam"]">
                    @Html.DisplayNameFor(model => model.number_of_lessons)
                </a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.discipline_name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.number_of_lessons)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.discipline_id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.discipline_id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.discipline_id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
